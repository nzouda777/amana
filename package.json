{
  "name": "amana-conseil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "cross-env SKIP_ENV_VALIDATION=1 payload generate:types",
    "generate:importmap": "cross-env SKIP_ENV_VALIDATION=1 payload generate:importmap",
    "migrate": "cross-env PAYLOAD_DB_DIRECT=1 payload migrate",
    "migrate:create": "cross-env SKIP_ENV_VALIDATION=1 payload migrate:create",
    "migrate:status": "cross-env PAYLOAD_DB_DIRECT=1 payload migrate:status",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "migrate:fresh": "cross-env PAYLOAD_DB_DIRECT=1 payload migrate:fresh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@react-email/render": "2.2.0",
    "class-variance-authority": "0.7.1",
    "graphql": "16.14.2",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "payload": "3.92.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "resend": "6.37.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
