# =============================================================================
# Amana Conseil — variables d'environnement
# Copier vers `.env` (jamais commité) et compléter. Validation au démarrage : src/env.ts
# =============================================================================

NODE_ENV=development

# --- Base de données : Neon (Postgres serverless), en dev comme en prod (ADR 005) ---
# Une branche Neon par environnement (dev, preview, prod), région Europe de préférence.
# `sslmode=verify-full` (pg traite déjà `require` ainsi et le fera évoluer en v9).
# Dans la console Neon :
# « Connection string » avec « Connection pooling » ACTIVÉ → DATABASE_URL (hôte en `-pooler`).
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.eu-central-1.aws.neon.tech/amana?sslmode=verify-full
# Même branche, « Connection pooling » DÉSACTIVÉ → connexion directe, utilisée par
# `pnpm migrate*` (DDL et verrous hors PgBouncer). Facultative en dev, requise en CI/prod.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.eu-central-1.aws.neon.tech/amana?sslmode=verify-full
# Connexions maximales du pool applicatif (par processus Node).
DATABASE_POOL_MAX=10

# --- Payload ---
# Au moins 32 caractères aléatoires : `openssl rand -hex 32`. Différent par environnement.
PAYLOAD_SECRET=

# --- URL publique (canonical, liens d'e-mails, retours de paiement) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement (ADR 006) : fournisseurs actifs, séparés par des virgules ---
# Valeurs : manual-transfer, sandbox (interdit en production). L'agrégateur Mobile Money
# (NotchPay, CinetPay…) sera ajouté quand le client l'aura choisi. TODO(client)
PAYMENT_PROVIDERS=manual-transfer,sandbox
# Secret HMAC du simulateur local (≥ 16 caractères).
PAYMENT_SANDBOX_SECRET=
# Coordonnées affichées pour le virement bancaire. TODO(client)
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_SWIFT=

# --- E-mails (M2) : Resend (transactionnel), Brevo (newsletter) ---
RESEND_API_KEY=
EMAIL_FROM="Amana Conseil <no-reply@example.com>"
BREVO_API_KEY=
# Liste Brevo des abonnés confirmés (identifiant numérique). TODO(client)
BREVO_LIST_ID=
# Sans RESEND_API_KEY, les e-mails sont écrits dans ce dossier (ignoré par git) au lieu d'être envoyés
# (hors production, ou ALLOW_DEV_SERVICES=1). En production sans Resend, le site et la connexion
# fonctionnent, mais l'inscription et les liens par e-mail sont indisponibles (ADR 021).
DEV_EMAIL_DIR=.dev-emails

# --- Vidéo (M3, ADR 017) ---
# `local` : fichiers de développement servis par /api/dev-video avec jeton signé (interdit
# en production). `bunny` : Bunny Stream, URLs HLS signées à durée courte.
VIDEO_PROVIDER=local
# Fournisseur local : `mp4` (un fichier video.mp4 par vidéo) ou `hls` (playlist.m3u8 + segments).
LOCAL_VIDEO_FORMAT=mp4
# Dossier local (ignoré par git) : <dossier>/<videoId>/video.mp4 ou playlist.m3u8.
LOCAL_VIDEO_DIR=.dev-media
# Bunny Stream — TODO(client) : aucun compte n'existe encore. Bibliothèque au nom du cabinet,
# « CDN token authentication » activée sur sa Pull Zone, rendus 240p/360p/720p.
# Stream > bibliothèque > API : identifiant numérique de la bibliothèque et clé d'API.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Pull Zone de la bibliothèque > Security > Token Authentication : « URL Token Authentication Key ».
BUNNY_STREAM_TOKEN_KEY=
# Nom d'hôte de la Pull Zone, sans https:// (ex. vz-abc123.b-cdn.net).
BUNNY_STREAM_CDN_HOSTNAME=
# Signature des webhooks d'encodage : clé d'API en LECTURE SEULE de la bibliothèque.
BUNNY_STREAM_WEBHOOK_SECRET=
# Rendu forcé en mode « économie de données ».
BUNNY_STREAM_DATA_SAVER_RENDITION=240p

# --- Rendez-vous (M2) : Cal.com ---
CALCOM_WEBHOOK_SECRET=
# Lien public de réservation (ex. amana-conseil/decouverte), sans domaine. TODO(client)
NEXT_PUBLIC_CALCOM_LINK=

# --- Anti-spam (M2) : Cloudflare Turnstile ---
# Désactivé par défaut (ADR 020) : 1 pour le réactiver sur tous les formulaires publics.
# Lu aussi par le navigateur : rebuild nécessaire après changement.
NEXT_PUBLIC_TURNSTILE_ENABLED=0
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vides en développement : clés de test Cloudflare « toujours valide » utilisées à la place.
# Obligatoires en production seulement si NEXT_PUBLIC_TURNSTILE_ENABLED=1 (src/env.ts).

# --- Build de production local / CI uniquement ---
# 1 : autorise les adaptateurs de développement (Turnstile de test, e-mails en fichier)
# avec NODE_ENV=production. Ne jamais activer sur le serveur de production.
ALLOW_DEV_SERVICES=0
